{
    "name": "med-mitra-backend",
    "version": "1.0.0",
    "description": "Backend API for Med Mitra Admin Portal",
    "main": "dist/server.js",
    "scripts": {
        "start": "node dist/server.js",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "db:init": "ts-node src/db/init.ts",
        "db:migrate:mobile": "ts-node src/db/add_mobile_column.ts",
        "seed:admin": "ts-node src/seed_admin.ts",
        "seed:data": "ts-node src/seed_data.ts",
        "reset:doctor": "ts-node src/force_reset.ts",
        "test:doctor": "ts-node src/test_doctor_backend.ts",
        "test:all": "ts-node src/test_all_endpoints.ts",
        "test:connectivity": "ts-node src/test-connectivity.ts",
        "test:unit": "jest --testPathPattern=src/__tests__",
        "init:firestore": "ts-node scripts/init-firestore.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^20.10.6",
        "@types/pg": "^8.10.9",
        "@types/qrcode": "^1.5.6",
        "axios": "^1.13.2",
        "bcrypt": "^5.1.1",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.2.1",
        "firebase": "^12.7.0",
        "firebase-admin": "^13.6.0",
        "jsonwebtoken": "^9.0.2",
        "otplib": "^12.0.1",
        "pg": "^8.11.3",
        "qrcode": "^1.5.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "jest": "^30.3.0",
        "ts-jest": "^29.4.9",
        "ts-node-dev": "^2.0.0"
    }
}